# Application
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
APP_TZ=Asia/Almaty
SECRET_KEY=change-me-please-32chars-min-1234567890

# Database
DATABASE_URL=sqlite:///./data/fund_reporting.db

# Storage
UPLOAD_DIR=./data/uploads
REPORT_DIR=./data/reports
LOG_DIR=./data/logs

# KASE
KASE_BONDS_URL=https://kase.kz/ru/bonds/
KASE_REPO_URL=https://kase.kz/ru/repo/
KASE_INDICES_URL=https://kase.kz/ru/indices/
KASE_CACHE_TTL_SECONDS=1800

# MBM
NBRK_MBM_URL=https://nationalbank.kz/ru/page/mbm
NBRK_RATES_URL=https://nationalbank.kz/ru/rates/

# Scheduler
KASE_FETCH_CRON_HOUR=18
KASE_FETCH_CRON_MINUTE=0

# SMTP (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=fund-reporting@kdif.kz

# Auth (admin panel)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
JWT_SECRET=please-change-me-jwt-secret-32-chars
JWT_TTL_MINUTES=120

# CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
